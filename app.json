{
  "expo": {
    "name": "RAINY Studio",
    "slug": "rainy-studio-mobile",
    "scheme": "rainystudio",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "platforms": [
      "ios",
      "android"
    ],
    "backgroundColor": "#F7F8FA",
    "ios": {
      "bundleIdentifier": "studio.rainy.mobile",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "studio.rainy.mobile",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF"
      }
    },
    "extra": {
      "appStage": "internal-mvp"
    },
    "newArchEnabled": true
  }
}
